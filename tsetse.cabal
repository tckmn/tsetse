cabal-version:      3.0
name:               tsetse
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             tckmn
build-type:         Simple

common warnings
    ghc-options: -Wall

executable tsetse
    import:           warnings
    main-is:          tsetse.hs
    build-depends:    base ^>=4.18.2.1,
                      random,
                      websockets,
                      aeson,
                      lens,
                      text, bytestring, unordered-containers, hashable, time, template-haskell, mtl, transformers, binary
    hs-source-dirs:   src
    default-language: Haskell2010
